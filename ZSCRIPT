version "4.14"

class PenetrationTracer : Actor
{
    Default
    {
        +NOBLOCKMAP;
        +NOGRAVITY;
        +DONTSPLASH;
        -SOLID;
        Radius 0;
        Height 0;
    }
    private Array<Actor> already_damaged;
	private Array<Line> hitWalls;

    bool HasDamagedActor(Actor a) const
    {
        for (int i = 0; i < already_damaged.Size(); i++)
        {
            if (already_damaged[i] == a) return true;
        }
        return false;
    }

    void MarkDamaged(Actor a)
    {
        already_damaged.Push(a);
    }
	
	void TrySprayEntryDecal(Line wallLine, Vector3 sprayPos, Vector3 shotDir, bool cvarMode)
    {
        if (!wallLine) return;
        if (hitWalls.Find(wallLine) != hitWalls.Size())
        {	
            return; 
        }
        hitWalls.Push(wallLine);
        Vector3 originalPos = self.Pos;
        SetOrigin(sprayPos, true);

        A_SprayDecal("BulletChip", 8.0, direction: -shotDir);
        if (cvarMode) A_SprayDecal("decg_dent", 8.0, direction: shotDir);
        SetOrigin(originalPos, true);
    }
}

class BulletPenetrationHandler : EventHandler
{
    private Array<Actor> shot_shooters;
    private Array<double> shot_angles;
    private Array<double> shot_pitches;
    private Array<int> shot_damages;

    override bool WorldHitscanPreFired(WorldEvent e)
    {
        Actor shooter = e.Thing;
        if (!shooter || !shooter.player) return false;
        PlayerInfo plr = shooter.player;
        if (!plr || plr.health <= 0) return false;

        if (e.AttackLineFlags & 1) return false;
        Weapon rw = plr.ReadyWeapon;
        if (!rw || rw.bMeleeWeapon) return false;

        CVar dbgCv = CVar.GetCVar("penetration_debug", plr);
        bool debug = (dbgCv && dbgCv.GetInt() != 0);

        if (CVar.GetCVar("mod_max_penetrations", plr).GetInt() <= 0) return false;

        shot_shooters.Push(shooter);
        shot_angles.Push(e.AttackAngle);
        shot_pitches.Push(e.AttackPitch);

        int dmg = e.Damage;
        if (dmg <= 0) dmg = 0; // you wand negative damage? wut ¯\_(ツ)_/¯
        shot_damages.Push(dmg);

        if (debug) Console.printf("[PEN] buffered shot: dmg=%d", dmg);
        return false; 
    }

    override void WorldTick()
    {
        for (int s = 0; s < shot_shooters.Size(); s++)
        {
            Actor shooter = shot_shooters[s];
            if (!shooter || !shooter.player) continue;
            PlayerInfo plr = shooter.player;
            if (!plr || plr.health <= 0) continue;

            int max_p = CVar.GetCVar("mod_max_penetrations", plr).GetInt();
            if (max_p <= 0) continue;
            int max_thickness = CVar.GetCVar("mod_max_wall_thickness", plr).GetInt();

            CVar dbgCv = CVar.GetCVar("mod_debug", plr);
            bool debug = (dbgCv && dbgCv.GetInt() != 0);

            double final_angle = shot_angles[s];
            double final_pitch = shot_pitches[s];
            int shot_damage = shot_damages[s];

            Vector3 t_dir = (
                cos(final_pitch) * cos(final_angle),
                cos(final_pitch) * sin(final_angle),
                -sin(final_pitch)
            );

            Vector3 eye_pos = shooter.Pos + (0, 0, plr.viewheight);
            FLineTraceData f_hit;
            shooter.LineTrace(final_angle, 16384, final_pitch, TRF_ALLACTORS, plr.viewheight, data: f_hit);

            if (debug) Console.printf("[PEN] shot %d: first hit type=%d dist=%.1f", s, f_hit.HitType, f_hit.Distance);
            if (f_hit.HitType == TRACE_HitNone) continue;
            Vector3 c_pos = eye_pos + (t_dir * f_hit.Distance);
            t_dir = (c_pos - eye_pos).Unit();

            int p_count = 0;
            int c_dmg = shot_damage;
            int guard = 0;
            FLineTraceData hit;

            if (f_hit.HitType == TRACE_HitWall || f_hit.HitType == TRACE_HitFloor || f_hit.HitType == TRACE_HitCeiling)
            {
                c_pos -= t_dir * 8.0;
            }

            let trc = PenetrationTracer(Actor.Spawn("PenetrationTracer", c_pos));
			CVar cvarMode = CVar.GetCVar('decal_mode', plr);
            if (trc)
            {
                    trc.target = shooter;
					trc.angle = VectorAngle(t_dir.X, t_dir.Y);
					trc.pitch = -asin(t_dir.Z);
					
					int current_hit_type = f_hit.HitType;
					Vector3 hit_spot = trc.Pos;

					if (f_hit.HitType == TRACE_HitWall)
					{
						trc.TrySprayEntryDecal(f_hit.HitLine, c_pos + (t_dir * 4.0), t_dir, cvarMode);
					}

					while (p_count < max_p)
					{
                    guard++;
                    if (guard > 2048) break;

                    // ok LET'S GOOOoooo.....
                    if (current_hit_type == TRACE_HitWall || current_hit_type == TRACE_HitFloor || current_hit_type == TRACE_HitCeiling)
                    {
                        Vector3 pos = trc.Pos;
                        Sector cur_sec = trc.Level.PointInSector(pos.XY);
                        if (!cur_sec) break;

                        double travelled = 0.0;
                        bool crossed = false;
                        Vector3 exit_pos = pos;

                        int max_steps = max_thickness / 8 + 8;
                        for (int step = 0; step < max_steps; step++)
                        {

                            Vector3 prev = pos;
                            pos += t_dir * 8.0;
                            travelled += 8.0;
                            if (travelled > max_thickness) break;

                            Sector s2 = trc.Level.PointInSector(pos.XY);
                            if (s2 == cur_sec) continue;
                            if (!s2) break;
							
                            bool thin_band = false;
                            Vector3 probe = pos;
                            for (int pk = 0; pk < 3; pk++)
                            {
                                probe += t_dir * 8.0;
                                if (trc.Level.PointInSector(probe.XY) != s2) { thin_band = true; break; }
                            }
                            if (debug) Console.printf("[PEN] scan step %d: new sector (floor=%.0f ceil=%.0f) thin=%d", step, s2.floorplane.ZatPoint(pos.XY), s2.ceilingplane.ZatPoint(pos.XY), thin_band ? 1 : 0);
                            if (thin_band)
                            {
                                cur_sec = s2;
                                continue;
                            }
                            Vector3 lo = prev;
                            Vector3 hi = pos;
                            for (int it = 0; it < 8; it++)
                            {
                                Vector3 mid = (lo + hi) * 0.5;
                                if (trc.Level.PointInSector(mid.XY) == cur_sec) lo = mid;
                                else hi = mid;
                            }
                            exit_pos = hi;
                            crossed = true;
                            break;
                        }
                        if (!crossed)
                        {
                            if (debug) Console.printf("[PEN] crossing FAILED at travelled=%.0f", travelled);
                            break;
                        }
                        p_count++;
                        if (debug) Console.printf("[PEN] crossed, penetration #%d, travelled=%.0f", p_count, travelled);
                        Sector exit_sector = trc.Level.PointInSector(exit_pos.XY);
                        if (exit_sector)
                        {
                            double floor_z = exit_sector.floorplane.ZatPoint(exit_pos.XY);
                            double ceil_z = exit_sector.ceilingplane.ZatPoint(exit_pos.XY);
                            if (exit_pos.Z <= floor_z || exit_pos.Z >= ceil_z)
                            {
                                if (debug) Console.printf("[PEN] exit blocked by floor/ceiling behind wall");
                                break;
                            }
                        }
                        trc.SetOrigin(exit_pos, true);
                        trc.LineTrace(trc.angle, 16384, trc.pitch, TRF_ALLACTORS, 0, data: hit);

                        double nudge = 4.0;
                        if (hit.HitType == TRACE_HitWall && hit.Distance < 8.0) nudge = hit.Distance * 0.5;
                        if (nudge < 0.25) nudge = 0.25;

                        Vector3 decal_origin = exit_pos + t_dir * nudge;
                        trc.SetOrigin(decal_origin, true);
						 if (hit.HitType == TRACE_HitWall && hit.HitLine != null)
                        {
                            double nudge = 4.0;
                            if (hit.Distance < 8.0) nudge = hit.Distance * 0.5;
                            if (nudge < 0.25) nudge = 0.25;

                            Vector3 decal_origin = exit_pos + t_dir * nudge;
                            trc.TrySprayEntryDecal(hit.HitLine, decal_origin, t_dir, cvarMode);
                        }
                        if (debug)
                        {
                            FLineTraceData dbg;
                            trc.LineTrace(back_probe_angle(t_dir), nudge + 4.0, back_probe_pitch(t_dir), TRF_ABSPOSITION | TRF_THRUACTORS, decal_origin.Z, decal_origin.X, decal_origin.Y, data: dbg);
                            Console.printf("[PEN] spray probe: type=%d dist=%.1f", dbg.HitType, dbg.Distance);
                        }
                        if (hit.HitType == TRACE_HitNone) break;
                        hit_spot = exit_pos + (t_dir * hit.Distance);
                        current_hit_type = hit.HitType;
                    }
                    else
                    {
                        trc.LineTrace(trc.angle, 16384, trc.pitch, TRF_ALLACTORS, 0, data: hit);
                        if (hit.HitType == TRACE_HitNone) break;
                        hit_spot = trc.Pos + (t_dir * hit.Distance);
                        current_hit_type = hit.HitType;
                    }
                    if (hit.HitType == TRACE_HitActor && hit.HitActor)
                    {
                        Actor victim = hit.HitActor;
                        if (victim != shooter && victim != f_hit.HitActor && !trc.HasDamagedActor(victim))
                        {
                            victim.DamageMobj(shooter, shooter, c_dmg, 'Bullet');
                            trc.MarkDamaged(victim);
                            if (debug) Console.printf("[PEN] actor hit: %s dmg=%d", victim.GetClassName(), c_dmg);
                        }
						else if (victim != shooter && victim != f_hit.HitActor && victim.bSHOOTABLE && !trc.HasDamagedActor(victim))
						{
                            victim.DamageMobj(shooter, shooter, c_dmg, 'Bullet');
                            trc.MarkDamaged(victim);
                            if (debug) Console.printf("[PEN] shootable hit(decoration?): %s dmg=%d", victim.GetClassName(), c_dmg);
                        }
                        double cosz = cos(trc.pitch);
                        if (cosz < 0.05) cosz = 0.05;
                        double skip = (victim.Radius * 2.2) / cosz + 2.0;
                        if (skip > 32.0) skip = 32.0;
                        trc.SetOrigin(hit_spot + t_dir * skip, true);
                    }
                    else if (hit.HitType == TRACE_HitWall)
                    {
                        Vector3 before = hit_spot - t_dir * 4.0;
                        trc.SetOrigin(before, true);
                        if (debug) Console.printf("[PEN] entry decal on next wall");
                    }
                    else
                    {
                        if (debug) Console.printf("[PEN] flight ended: hit floor/ceiling");
                        break;
                    }
                }
                trc.Destroy();
            }
        }
        shot_shooters.Clear();
        shot_angles.Clear();
        shot_pitches.Clear();
        shot_damages.Clear();
    }
    private double back_probe_angle(Vector3 t_dir) { return VectorAngle(-t_dir.X, -t_dir.Y); }
    private double back_probe_pitch(Vector3 t_dir) { return asin(t_dir.Z); }
}