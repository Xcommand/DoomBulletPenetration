version "4.14"

#include "z_script/targetdummy.zs"

class PenetrationTracer : Actor
{
	Default
	{
		+NOBLOCKMAP;
		+NOGRAVITY;
		+DONTSPLASH;
		-SOLID;
		Radius 1;
		Height 1;
	}
	private Array<Actor> already_damaged;

	bool HasDamagedActor(Actor a) const
	{
		for (int i = 0; i < already_damaged.Size(); i++)
			if (already_damaged[i] == a) return true;
		return false;
	}
	void MarkDamaged(Actor a) { already_damaged.Push(a); }
    void SprayDecalFromPos(Vector3 pos, double ang, double pit, int style, bool dent, bool blood, Actor bloodActor)
	{
		SetOrigin(pos, true);
		self.angle = ang;
		self.pitch = pit;

		Vector3 dir = (cos(pit) * cos(ang), cos(pit) * sin(ang), -sin(pit)); 													 // uuuuugh math :<
		if (blood && bloodActor)
		{
			CopyBloodColor(bloodActor);
			if (!dent && (style == 1 || style == 2)) A_SprayDecal("bldstr1", 32.0, useBloodColor: true, direction: dir);		 // 1.2a bloody hole
			if (!dent && (style == 3)) A_SprayDecal("bldstrhd", 32.0, useBloodColor: true, direction: dir);					 // 1.2a bloody hole
		}

		switch (style)
		{
			case 0: break;
			case 1:	A_SprayDecal("BulletChip", 32.0, direction: dir); break;
			case 2: A_SprayDecal("cout", 32.0, direction: dir); break;
			case 3: A_SprayDecal("couthd", 32.0, direction: dir); break;
		}
		if (dent) A_SprayDecal("decg_dent", 32.0, direction: dir);
	}
}

class BulletPenetrationHandler : EventHandler
{
	private Array<Actor>  shot_shooters;
	private Array<double> shot_angles;
	private Array<double> shot_pitches;
	private Array<int>	shot_damages;
	private Array<Actor>  vanilla_hit;
	private bool we_damaging;

	private void PushVec(Array<double> xs, Array<double> ys, Array<double> zs, Vector3 v)
	{
		xs.Push(v.X); ys.Push(v.Y); zs.Push(v.Z);
	}

	override bool WorldHitscanPreFired(WorldEvent e)
	{
		Actor shooter = e.Thing;
		if (!shooter || !shooter.player) return false;
		PlayerInfo plr = shooter.player;
		if (!plr || plr.health <= 0) return false;
		if (e.AttackLineFlags & (1 | 2 | 8)) return false;
		Weapon rw = plr.ReadyWeapon;
		if (!rw || rw.bMeleeWeapon) return false;
		if (CVar.GetCVar("mod_max_penetrations", plr).GetInt() <= 0) return false;

		shot_shooters.Push(shooter);
		shot_angles.Push(e.AttackAngle);
		shot_pitches.Push(e.AttackPitch);
		int dmg = e.Damage;
		if (dmg <= 0) dmg = 0;
		shot_damages.Push(dmg);
		return false;
	}

	override void WorldThingDamaged(WorldEvent e)
	{
		if (we_damaging) return;
		if (!e.Thing || !e.DamageSource) return;

		for (int i = 0; i < shot_shooters.Size(); i++)
		{
			if (shot_shooters[i] == e.DamageSource)
			{
				vanilla_hit.Push(e.Thing);
				return;
			}
		}
	}

	override void WorldTick()
	{
		for (int s = 0; s < shot_shooters.Size(); s++)
		{
			Actor shooter = shot_shooters[s];
			if (!shooter || !shooter.player) continue;
			PlayerInfo plr = shooter.player;
			if (!plr || plr.health <= 0) continue;

			int max_p = CVar.GetCVar("mod_max_penetrations", plr).GetInt();
			if (max_p <= 0) continue;
			int max_thickness = CVar.GetCVar("mod_max_wall_thickness", plr).GetInt();
			if (max_thickness < 1) max_thickness = 1;

			CVar dbgCv = CVar.GetCVar("penetration_debug", plr);
			bool debug = (dbgCv && dbgCv.GetInt() != 0);

			CVar bldCv = CVar.GetCVar("blood_transfer", plr); // 1.2a bloody hole
			bool bldhole = (bldCv);		 // 1.2a bloody hole

			double final_angle = shot_angles[s];
			double final_pitch = shot_pitches[s];
			int	shot_damage = shot_damages[s];

			Vector3 t_dir = (cos(final_pitch) * cos(final_angle), cos(final_pitch) * sin(final_angle), -sin(final_pitch));
			Vector3 eye_pos = shooter.Pos + (0, 0, plr.viewheight);

			let trc = PenetrationTracer(Actor.Spawn("PenetrationTracer", eye_pos));
			if (!trc) continue;
			trc.target = shooter;
			trc.angle  = final_angle;
			trc.pitch  = final_pitch;

			if (debug) Console.printf("[PEN] shot: ang=%.2f pit=%.2f dir=(%.3f,%.3f,%.3f)", final_angle, final_pitch, t_dir.X, t_dir.Y, t_dir.Z);

			bool bDentMode  = CVar.GetCVar('decal_mode', plr).GetBool();
			int  iCoutStyle = CVar.GetCVar("decal_modeHD", plr).GetInt();

			Array<double> entryX;
			Array<double> entryY;
			Array<double> entryZ;
			Array<double> exitX;
			Array<double> exitY;
			Array<double> exitZ;
            Array<int>    entryBlood;		 // 1.2a bloody hole
            Array<int>    exitBlood;		 // 1.2a bloody hole
            Array<Actor>  entryBloodActor;	 // 1.2a bloody hole
            Array<Actor>  exitBloodActor;	 // 1.2a bloody hole
			int  blood_so_far = 0;			 // 1.2a bloody hole
            Actor blood_actor_so_far = null; // 1.2a bloody hole

			int  wallCount  = 0;
			int  actorCount = 0;
			int  c_dmg = shot_damage;
			bool first_hit = true;
			Vector3 cur_pos = eye_pos;
			int guard = 0;

			while (wallCount < max_p && guard++ < 128) // lets add mod_max_penetrations max value just in case ¯\_(ツ)_/¯
			{
				trc.SetOrigin(cur_pos, true);
				FLineTraceData hit;
				trc.LineTrace(trc.angle, 16384, trc.pitch, TRF_ALLACTORS, 0, data: hit);

				if (hit.HitType == TRACE_HitNone ||	hit.HitType == TRACE_HitFloor || hit.HitType == TRACE_HitCeiling) break;
				Vector3 hit_spot = cur_pos + t_dir * hit.Distance;

				if (hit.HitType == TRACE_HitActor && hit.HitActor)
				{
					Actor victim = hit.HitActor;

					double cosz = cos(final_pitch);
					if (cosz < 0.05) cosz = 0.05;
					double skip = (victim.Radius * 3.0) / cosz + 6.0;
					if (skip > 128.0) skip = 128.0;

					if (victim == shooter) // ah hell naw i'm not the one who bleeds here
					{
						cur_pos = hit_spot + t_dir * skip;
						first_hit = false;
						continue;
					}

					bool already = false;

					for (int k = 0; k < vanilla_hit.Size(); k++)
						if (vanilla_hit[k] == victim) { already = true; break; }

					if (!first_hit && victim != shooter && !trc.HasDamagedActor(victim) && !already)
					{
						we_damaging = true;
						victim.DamageMobj(shooter, shooter, c_dmg, 'Bullet');
						we_damaging = false;
						actorCount++;
						if (debug) Console.printf("[PEN] dmg %s", victim.GetClassName());
					}

					trc.MarkDamaged(victim);
					if (!victim.bNoBlood && bldhole)
					{
						blood_so_far = 1; // 1.2a bloody hole
						blood_actor_so_far = victim;
					}
					cur_pos = hit_spot + t_dir * skip;
					first_hit = false;
					continue;
				}

				if (hit.HitType == TRACE_HitWall && hit.HitLine)
				{
					Line entry_line = hit.HitLine;
					PushVec(entryX, entryY, entryZ, hit_spot);
					entryBlood.Push(blood_so_far);
                    entryBloodActor.Push(blood_actor_so_far);

					Vector3 exit_pos  = hit_spot;
					bool   found_exit = false;
					double probe_dist = 4.0;

					for (int attempt = 0; attempt < 12; attempt++)
					{
						if (probe_dist > double(max_thickness) + 4.0) break;

						Vector3 probe = hit_spot + t_dir * probe_dist;
						trc.SetOrigin(probe, true);
						FLineTraceData back;
						trc.LineTrace(final_angle + 180.0, probe_dist, -final_pitch, TRF_THRUACTORS, 0, data: back);

						if (back.HitType == TRACE_HitWall && back.HitLine != null && back.HitLine != entry_line && back.Distance > 0.05 && back.Distance < probe_dist - 0.05)
						{
							exit_pos   = probe - t_dir * back.Distance;
							found_exit = true;
							if (debug)
								Console.printf("[PEN] #%d: back probe=%.1f hit=%.2f exit=%.2f", wallCount + 1, probe_dist, back.Distance, probe_dist - back.Distance);
							break;
						}
						probe_dist *= 2.0;
					}

					if (!found_exit)
					{
						if (debug) Console.printf("[OHNO] #%d: no exit", wallCount + 1); // LET ME IIIINNNN https://www.youtube.com/watch?v=ow-WdjzfmaI
						break;
					}
					double thickness = (exit_pos - hit_spot).Length();
					PushVec(exitX, exitY, exitZ, exit_pos);
					exitBlood.Push(blood_so_far);
                    exitBloodActor.Push(blood_actor_so_far);
					wallCount++;

					if (debug)
						Console.printf("[PEN] wall #%d: thickness=%.2f blood=%d", wallCount, thickness, blood_so_far);

					cur_pos   = exit_pos + t_dir * 0.5;
					first_hit = false;
					continue;
				}
				break;
			}

			for (int i = 0; i < entryX.Size(); i++)
			{
				Vector3 h = (entryX[i], entryY[i], entryZ[i]);
				Vector3 sprayPos = h - t_dir * 4.0;
				bool blood = (entryBlood[i] != 0);

				if (i == 0)
				{
					if (bDentMode) trc.SprayDecalFromPos(sprayPos, final_angle, final_pitch, 0, true, false, null);
					continue;
				}
				trc.SprayDecalFromPos(sprayPos, final_angle, final_pitch, iCoutStyle, false, (entryBlood[i] != 0), entryBloodActor[i]);
			}

			for (int i = 0; i < exitX.Size(); i++)
			{
				Vector3 h = (exitX[i], exitY[i], exitZ[i]);
				Vector3 sprayPos = h + t_dir * 4.0;
				bool blood = (exitBlood[i] != 0);
				trc.SprayDecalFromPos(sprayPos, final_angle + 180.0, -final_pitch, iCoutStyle, false, (exitBlood[i] != 0), exitBloodActor[i]);
			}
			trc.Destroy();
			if (debug) Console.printf("[TELLER] done: walls=%d actors=%d", wallCount, actorCount); // Penn and Teller. Get it? ha? well ok :<
		}
		shot_shooters.Clear();
		shot_angles.Clear();
		shot_pitches.Clear();
		shot_damages.Clear();
		vanilla_hit.Clear();
	}
}
